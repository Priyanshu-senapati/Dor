# Postgres (Neon). Added automatically when you connect Neon from the Vercel Storage tab.
DATABASE_URL=
# Long random strings: openssl rand -hex 32
SESSION_SECRET=
CRON_SECRET=
# Gmail address that sends reminders, and its app password (myaccount.google.com/apppasswords)
SMTP_USER=
SMTP_PASS=
# Optional: Gemini API key (aistudio.google.com/apikey) for handoff briefings.
# Without it, Dor writes a plain-text briefing instead.
GEMINI_API_KEY=
# Optional: override the Gemini model (default: gemini-3.1-flash-lite)
GEMINI_MODEL=
# Optional: public URL used in email links (defaults to the Vercel production URL)
APP_URL=
# Seed only: demo members get +kamala/+riya/+arjun versions of this address
DEMO_EMAIL=
